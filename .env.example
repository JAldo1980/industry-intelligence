# The app runs with no settings at all. Copy this file to .env only if you want to change something.
# Never commit .env.

# Asks for a password before showing the app. Required when hosted on Render.
APP_PASSWORD=

# OPTIONAL: official Companies House API for company lookup. The public register is used if unset.
COMPANIES_HOUSE_API_KEY=

# OPTIONAL: settings (defaults shown)
# PORT=8787
# HOST=127.0.0.1
# DATA_DIR=data
# REPORTS_PER_HOUR=12
# MAX_CONCURRENT_REPORTS=2
# MAX_COMPANIES=6

# Nomis's robots.txt disallows its dataset API. Leave this off unless you have checked
# Nomis's terms and decided your use is permitted. It adds employment by SIC division.
# NOMIS_API_ALLOWED=false
