    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "robots-parser": "^3.0.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
